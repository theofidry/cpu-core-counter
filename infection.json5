{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.26.16/resources/schema.json",
    "ignoreMsiWithNoMutations": true,
    "logs": {
        "text": ".build/infection/infection-log.txt"
    },
    "minCoveredMsi": 100,
    "minMsi": 100,
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,

    "mutators": {
        "global-ignore": [
            "Fidry\\CpuCoreCounter\\Finder\\NProcFinder::getCommand"
        ],
        "@default": true,
        "ArrayItemRemoval": {
            "ignore": [
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::getDefaultFinders"
            ]
        },
        "Assignment": {
            "ignore": [
                // False positive: a controller is bound to a single hierarchy,
                // so the quotas can only come from either v1 or v2.
                "Fidry\\CpuCoreCounter\\Finder\\CgroupCpuQuotaFinder::findQuotas"
            ]
        },
        "CastInt": {
            "ignore": [
                // False positive: PHP handles the numeric strings the same way,
                // the cast is for PHPStan.
                "Fidry\\CpuCoreCounter\\Finder\\CpuAffinityFinder::countCpuCores"
            ]
        },
        "CastString": {
            "ignore": [
                // I can't find a case in practice where this would happen.
                "Fidry\\CpuCoreCounter\\Executor\\ProcOpenExecutor::execute"
            ]
        },
        "Coalesce": {
            "ignore": [
                // Cannot test this case.
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::getAvailableForParallelisation",
                // Not interested in testing this case.
                "Fidry\\CpuCoreCounter\\Finder\\ProcOpenBasedFinder::diagnose"
            ]
        },
        "Continue_": false,
        "DecrementInteger": {
            "ignore": [
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::getAvailableForParallelisation"
            ]
        },
        "FalseValue": {
            "ignore": [
                // Cannot test this case: it requires getenv() to be disabled,
                // which is only covered by RestrictedEnvironmentTest.
                "Fidry\\CpuCoreCounter\\Env::get"
            ]
        },
        "Foreach_": {
            "ignore": [
                // Cannot test this case: it requires one of the functions to
                // be disabled, which is only covered by RestrictedEnvironmentTest.
                "Fidry\\CpuCoreCounter\\Executor\\ProcOpenExecutor::getUnavailabilityReason"
            ]
        },
        "FunctionCallRemoval": {
            "ignore": [
                // I can't find a case in practice where this would happen.
                "Fidry\\CpuCoreCounter\\Executor\\ProcOpenExecutor::execute"
            ]
        },
        "GreaterThan": {
            "ignore": [
                // This is an actual false positive.
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::getAvailableForParallelisation",
                // False positive: the count is never 0, the check is for PHPStan.
                "Fidry\\CpuCoreCounter\\Finder\\CpuAffinityFinder::countCpuCores"
            ]
        },
        "IncrementInteger": {
            "ignore": [
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::getAvailableForParallelisation"
            ]
        },
        "LogicalOr": {
            "ignore": [
                // False positive: the mutant only differs when exactly one
                // stream_get_contents() call fails, which cannot be reproduced.
                "Fidry\\CpuCoreCounter\\Executor\\ProcOpenExecutor::execute",
                // Cannot test this case: it requires exactly one of the
                // functions to be disabled, which is only covered by
                // RestrictedEnvironmentTest.
                "Fidry\\CpuCoreCounter\\FileReader\\NativeFileReader::read"
            ]
        },
        "OneZeroFloat": {
            "ignore": [
                // Cannot test this case.
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::getAvailableForParallelisation"
            ]
        },
        "PublicVisibility": false,
        "ReturnRemoval": {
            "ignore": [
                // This is a perf improvement
                "Fidry\\CpuCoreCounter\\CpuCoreCounter::checkLoadLimit"
            ]
        },
        "TrueValue": {
            "ignore": [
                // This is a case where the value does not matter.
                "Fidry\\CpuCoreCounter\\Finder\\LscpuPhysicalFinder::countCpuCores"
            ]
        },
        "UnwrapArrayValues": {
            "ignore": [
                // False positive: the keys are never used, it is only to get a list.
                "Fidry\\CpuCoreCounter\\Finder\\FirstCpuCoreFinder::__construct"
            ]
        }
    }
}
